{
  "name": "point-code",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.6.0",
  "publisher": "personal-tools",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "inspect",
    "inspector",
    "devtools",
    "click to source",
    "css",
    "cascade",
    "tailwind",
    "design tokens",
    "react",
    "vue",
    "svelte",
    "nextjs",
    "cursor",
    "visual editor",
    "live preview",
    "hmr",
    "frontend"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ast2r2sk-coder/point-code.git"
  },
  "bugs": {
    "url": "https://github.com/ast2r2sk-coder/point-code/issues"
  },
  "homepage": "https://github.com/ast2r2sk-coder/point-code#readme",
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onCommand:pointCode.start",
    "onView:pointCode.inspector",
    "onView:pointCode.palette",
    "onView:pointCode.screens"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "package": "python package-vsix.py"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pointCode",
          "title": "Point Code",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pointCode": [
        {
          "type": "webview",
          "id": "pointCode.inspector",
          "name": "%view.inspector%"
        },
        {
          "type": "webview",
          "id": "pointCode.palette",
          "name": "%view.palette%"
        },
        {
          "type": "webview",
          "id": "pointCode.screens",
          "name": "%view.screens%"
        }
      ]
    },
    "commands": [
      {
        "command": "pointCode.start",
        "title": "%cmd.start%",
        "category": "Point Code"
      },
      {
        "command": "pointCode.changeUrl",
        "title": "%cmd.changeUrl%",
        "category": "Point Code"
      },
      {
        "command": "pointCode.openPalette",
        "title": "%cmd.openPalette%",
        "category": "Point Code"
      },
      {
        "command": "pointCode.openScreens",
        "title": "%cmd.openScreens%",
        "category": "Point Code"
      },
      {
        "command": "pointCode.copyProxyUrl",
        "title": "%cmd.copyProxyUrl%",
        "category": "Point Code"
      },
      {
        "command": "pointCode.copyScript",
        "title": "%cmd.copyScript%",
        "category": "Point Code"
      },
      {
        "command": "pointCode.styles",
        "title": "%cmd.styles%",
        "category": "Point Code"
      },
      {
        "command": "pointCode.palette.refresh",
        "title": "%cmd.palette.refresh%",
        "category": "Point Code"
      },
      {
        "command": "pointCode.screens.refresh",
        "title": "%cmd.screens.refresh%",
        "category": "Point Code"
      },
      {
        "command": "pointCode.stop",
        "title": "%cmd.stop%",
        "category": "Point Code"
      }
    ]
  }
}
